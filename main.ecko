# clipboard - read and write the OS clipboard.
#
#   import clipboard
#
#   clipboard.copy("hello")
#   clipboard.paste()          # "hello"
#
# It drives the platform's own tool rather than talking to the display server
# directly, and that is deliberate rather than lazy. On X11 the clipboard lives
# in the *owning process*: whoever set it must stay alive to serve it, so a
# program that writes and exits leaves an empty clipboard behind. `xclip` and
# `wl-copy` already fork a holder to solve this. Linking a clipboard library
# instead would mean either keeping the interpreter alive after your program
# ended, or shipping a daemon - and on Linux it would add X11 and Wayland
# libraries to a binary that is otherwise self-contained.
#
# What that costs: on Linux one of `wl-copy`, `xclip` or `xsel` must be
# installed. macOS and Windows ship theirs. `available()` tells you which
# situation you are in without raising, and a failed `copy` or `paste` names
# the package to install.

import std.os
import std.proc
import std.io
import "./backends.ecko"

# How long a clipboard tool may take before it is killed and the call fails.
DEADLINE_MS = 5000

# A failure of the clipboard or its tool: kind `clipboard`.
fn fail(reason, message) = error({ kind: "clipboard", reason: reason, message: message })

# An environment variable that is set and not empty: `DISPLAY=` is no display.
fn env_set(name) {
    v = os.env(name)
    not is_null(v) and trim(v) != ""
}

fn has_display() = env_set("WAYLAND_DISPLAY") or env_set("DISPLAY")

# Whether this platform keeps its clipboard in a display server.
fn needs_display() = not contains(["macos", "windows"], os.platform())

# The first backend on this platform whose tool is actually installed.
fn chosen() {
    mut found = null
    for name in backends.candidates(os.platform(), env_set("WAYLAND_DISPLAY"), env_set("DISPLAY")) {
        if is_null(found) and backends.on_path(get(backends.COPY, name).cmd) { found = name }
    }
    found
}

# The backend to use, or the error saying why there is none.
fn require(fname) {
    name = chosen()
    unless is_null(name) { return name }
    if needs_display() and not has_display() {
        fail(
            "no_display",
            "clipboard." +
                fname +
                ": this session has no display server (neither WAYLAND_DISPLAY nor DISPLAY " +
                "is set), so there is no clipboard to reach. Over SSH, forward X11 (`ssh -X`) or run inside the " +
                "desktop session.",
        )
    }
    if os.platform() == "linux" or needs_display() {
        fail(
            "no_tool",
            "clipboard." +
                fname +
                ": no clipboard tool found. Install one of: wl-copy (wl-clipboard) on Wayland, " +
                "or xclip or xsel on X11.",
        )
    }
    fail(
        "no_tool",
        "clipboard." + fname + ": no clipboard tool found for platform '" + os.platform() + "'.",
    )
}

# The reason a tool's result says it failed, as text for an error message.
fn why(r) {
    detail = trim(r.stderr)
    if detail == "" {
        "exited with code " + string(r.code) + " and printed nothing"
    } else {
        detail
    }
}

## The tool this machine would use (`"wl-copy"`, `"xclip"`, `"xsel"`, `"pbcopy"` or `"clip"`), or `null` when there is none.
##
## Useful in a diagnostic or a bug report: "xclip" and "wl-copy" behave
## differently under a Wayland session running XWayland, and knowing which one
## answered explains a clipboard that seems to write but never paste. Needs
## `exec` and `env`.
##
## example:
##   clipboard.backend()   # "xclip"
export fn backend() = chosen()

## Whether copy and paste will work here, as a Bool.
##
## Answers `false` rather than raising, so a program can degrade politely -
## print the text instead of copying it - rather than wrapping every call in
## `try`. Needs `exec` and `env`.
##
## example:
##   if clipboard.available() { clipboard.copy(answer) } else { print(answer) }
export fn available() = not is_null(chosen())

## Puts `text` on the clipboard and returns `null`.
##
## The tool gets 5 seconds; past that it is killed and the call fails.
## Needs `exec` and `env`.
##
## errors: `clipboard`/`no_display` when a Linux session has no display server; `clipboard`/`no_tool` when no clipboard tool is installed; `clipboard`/`tool_failed` when the tool exits non-zero; `clipboard`/`timeout` when it does not finish in 5 seconds; `bug`/`bad_argument` when `text` is not a String (a secret must be revealed first, deliberately).
##
## example:
##   clipboard.copy("hello")
export fn copy(text) {
    unless type_of(text) == "string" {
        hint = if type_of(text) == "secret" {
            "; pass reveal(x) to copy a secret deliberately"
        } else {
            ""
        }
        error(
            {
                kind: "bug",
                reason: "bad_argument",
                message: "clipboard.copy: text must be a String, got " + type_of(text) + hint,
            },
        )
    }
    name = require("copy")
    b = get(backends.COPY, name)
    p = proc.spawn(b.cmd, b.args)
    input = proc.stdin(p)
    io.timeout(input, DEADLINE_MS)
    # A tool that exits early closes its stdin; its exit status and stderr say
    # why, so the write failing is not the error to report.
    try {
        io.write(input, text)
        io.close(input)
    } catch { null }
    r = proc.wait(p, DEADLINE_MS)
    if r.timed_out {
        fail("timeout", "clipboard.copy: " + b.cmd + " did not finish within 5s and was killed.")
    }
    unless r.code == 0 {
        fail("tool_failed", "clipboard.copy: " + b.cmd + " failed writing the clipboard: " + why(r))
    }
    null
}

# Whether a failed paste means only that the clipboard is empty: xclip's
# "target STRING not available", wl-paste's "Nothing is copied" / "No selection".
fn empty_clipboard(r) {
    e = r.stderr
    contains(e, "target ") and contains(e, "not available") or
        contains(e, "Nothing is copied") or
        contains(e, "No selection")
}

## The clipboard's contents as a String, or `""` when it is empty.
##
## The tool gets 5 seconds; past that it is killed and the call fails.
## Needs `exec` and `env`.
##
## errors: `clipboard`/`no_display` when a Linux session has no display server; `clipboard`/`no_tool` when no clipboard tool is installed; `clipboard`/`tool_failed` when the tool fails for a reason other than an empty clipboard; `clipboard`/`timeout` when it does not finish in 5 seconds.
##
## example:
##   clipboard.paste()   # "hello"
export fn paste() {
    name = require("paste")
    b = get(backends.PASTE, name)
    r = proc.run(b.cmd, b.args, timeout_ms: DEADLINE_MS)
    if r.timed_out {
        fail("timeout", "clipboard.paste: " + b.cmd + " did not finish within 5s and was killed.")
    }
    unless r.code == 0 {
        if empty_clipboard(r) { return "" }
        fail(
            "tool_failed",
            "clipboard.paste: " + b.cmd + " failed reading the clipboard: " + why(r),
        )
    }
    # PowerShell ends what it prints with a line break that is not clipboard
    # content.
    if name == "clip" and ends_with(r.stdout, "\r\n") {
        r.stdout[0..len(r.stdout) - 2]
    } else {
        r.stdout
    }
}
